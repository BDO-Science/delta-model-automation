# Description
# Historical study
# 202208
ENVVAR
NAME                     VALUE
WEEK					 20260616
DSM2MODIFIER             ${WEEK}-21C                #Study name used for DSM2 output
INSERT_NODE				314							#Chipps Island
PTM_START_DATE           23May2026
END_DATE                 07Jul2026
END_TIME                 0000
TEMPDIR                  N/A
#Input envvars
STUDYDIR                 ./././
TSINPUTDIR               N/A
#Output
DSM2OUTPUTDIR            ${STUDYDIR}/Output/${WEEK}/PTM/np
DSM2SHAREDDIR            ${STUDYDIR}/Output/${WEEK}
OUTPUTFILE               N/A
#Hydro
HYDROTIDEFILE            ${DSM2SHAREDDIR}/hydro/${DSM2MODIFIER}.h5
#PTM
PTMOUTFILE               ${DSM2OUTPUTDIR}/${DSM2MODIFIER}_NPptm_${INSERT_NODE}.pof
#PTMOUTPUTFILE            ${DSM2OUTPUTDIR}/${DSM2MODIFIER}_NPptm_${INSERT_NODE}.txt
PTMOUTPUTFILE            ${DSM2OUTPUTDIR}/${DSM2MODIFIER}_NPptm_${INSERT_NODE}.dss
END