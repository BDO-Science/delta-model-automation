
CONFIGURATION
input\configuration_forecastC.inp
END



SCALAR
NAME            VALUE                                
title           "Hydro simulation: ${DSM2MODIFIER}" 
checkdata       false                                 
cont_bad        false                                 
cont_missing    true                                  
cont_question   true                                  
cont_unchecked  true                                  
deltax          5000                                  
display_intvl   1day                                                                  
gravity         32.2                                  
hydro_time_step 15min                                 
levee_slope     0.33                                  
maxiter         20                                    
printlevel      1                                     
theta           0.6                                   
toleranceq      0.001                                 
tolerancez      0.0008                                
warn_missing    false                                  
warn_question   true                                  
warn_unchecked  false                                 
run_start_date  ${START_DATE}                         
run_end_date    ${END_DATE}                           
run_start_time  ${START_TIME}                         
temp_dir        c:/temp
binary_output   false
dss_direct      true
flush_output    20day                              
END



IO_FILE
MODEL TYPE    IO  INTERVAL FILE                          
hydro hdf5    out    15min ${HYDROTIDEFILE}               #Flow data to be passed to qual and ptm 
hydro restart out     1mon ${HYDRORSTFILE}                #Initial condition a restart is required
hydro output  out     none ${HYDROOUTFILE}                #Echoed run status                      
hydro echo    out     none ${DSM2OUTPUTDIR}/hydro_echo_${DSM2MODIFIER}.inp #Echoed input                           
END



PARAMETER
${INPUTDIR}/hydro/scalar_hydro_fore_102009.inp
END

GRID
${DSM2INPUTDIR}/common_input/channel_std_delta_grid_NAVD_20121214.inp
#${INPUTDIR}/hydro/channel_std_delta_grid_NAVD_20121214_modi.inp
${DSM2INPUTDIR}/common_input/gate_std_delta_grid_20141017_NAVD.inp
#${DSM2INPUTDIR}/common_input/gate_std_delta_grid_20141017_NAVD_not.inp
${DSM2INPUTDIR}/common_input/reservoir_std_delta_grid_NAVD_20131125.inp
${DSM2INPUTDIR}/common_input/channel_historical_stability_revision_20090715.inp
#${DSM2INPUTDIR}/common_input/channel_tapered_tracy_blvd_dredge_20090715.inp
#${DSM2INPUTDIR}/common_input/channel_paradise_cut_dredge_20091222.inp
#${INPUTDIR}/hydro/gate_closure_drought_study_DB2S.inp
#${INPUTDIR}/hydro/gate_closure_drought_study_DB2S-ts.inp
END

INITIAL_CONDITION
${INPUTDIR}/hydro/channel_ic_std_delta_grid_NAVD_20121214.inp
${INPUTDIR}/hydro/reservoir_ic_std_delta_grid_NAVD_20131125.inp
END

HYDRO_TIME_SERIES
